fn make_grid(w, h) {
    grid := list()
    for _ in range(h) {
        row := list()
        for _ in range(w) {
            push(row, 0)
        }
        push(grid, row)
    }
    return grid
}

fn get_cell(grid, x, y, w, h) {
    if x < 0 or y < 0 or x >= w or y >= h {
        return 0
    }
    return grid[y][x]
}

fn set_cell(grid, x, y, value) {
    grid[y][x] = value
}

fn count_neighbors(grid, x, y, w, h) {
    count := 0
    for dy in range(3) {
        for dx in range(3) {
            if dx == 1 and dy == 1 {
                continue
            }
            nx := x + dx - 1
            ny := y + dy - 1
            count = count + get_cell(grid, nx, ny, w, h)
        }
    }
    return count
}

fn step_grid(grid, w, h) {
    next := make_grid(w, h)
    for y in range(h) {
        for x in range(w) {
            alive := get_cell(grid, x, y, w, h)
            neighbors := count_neighbors(grid, x, y, w, h)
            if alive {
                if neighbors == 2 or neighbors == 3 {
                    set_cell(next, x, y, 1)
                }
            } else {
                if neighbors == 3 {
                    set_cell(next, x, y, 1)
                }
            }
        }
    }
    return next
}

fn render(grid, w, h, step) {
    output := "Step " + string(step) + "\n"
    for y in range(h) {
        line := ""
        for x in range(w) {
            if grid[y][x] {
                line = line + "██"
            } else {
                line = line + "  "
            }
        }
        output = output + line + "\n"
    }
    output = output + "\n"
    print(output)
}

width := 40
height := 25
steps := 200
delay_ms := 50

grid := make_grid(width, height)

# Gosper glider gun
gun := list(
    list(1, 5), list(1, 6), list(2, 5), list(2, 6),
    list(11, 5), list(11, 6), list(11, 7), list(12, 4), list(12, 8),
    list(13, 3), list(13, 9), list(14, 3), list(14, 9), list(15, 6),
    list(16, 4), list(16, 8), list(17, 5), list(17, 6), list(17, 7),
    list(18, 6),
    list(21, 3), list(21, 4), list(21, 5), list(22, 3), list(22, 4),
    list(22, 5), list(23, 2), list(23, 6), list(25, 1), list(25, 2),
    list(25, 6), list(25, 7),
    list(35, 3), list(35, 4), list(36, 3), list(36, 4)
)

for _, pos in gun {
    set_cell(grid, pos[0], pos[1], 1)
}

for i in range(steps) {
    render(grid, width, height, i)
    grid = step_grid(grid, width, height)
    sleep(delay_ms)
}
